{
    "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
    "assist": {
        "actions": {
            "source": {
                "organizeImports": "on"
            }
        }
    },
    "vcs": {
        "enabled": true,
        "clientKind": "git",
        "useIgnoreFile": true
    },
    "files": {
        "includes": [
            "**",
            "!.githooks",
            "!docs",
            "!**/*.generated.ts",
            "!packages/plugin/types",
            "!packages/webui/index.html",
            "!packages/webui/dist"
        ]
    },
    "formatter": {
        "indentStyle": "space",
        "indentWidth": 4
    },
    "javascript": {
        "formatter": {
            "quoteStyle": "single",
            "semicolons": "always",
            "bracketSpacing": true,
            "lineWidth": 70
        }
    },
    "css": {
        "parser": {
            "cssModules": true,
            "tailwindDirectives": true
        }
    },
    "linter": {
        "enabled": true,
        "rules": {
            "preset": "recommended",
            "suspicious": {
                "noUnknownAtRules": {
                    "level": "error",
                    "options": {
                        "ignore": ["tailwind"]
                    }
                }
            }
        }
    },
    "overrides": [
        {
            "includes": ["packages/webui/src/index.css"],
            "linter": {
                "rules": {
                    "complexity": {
                        "noImportantStyles": "off"
                    }
                }
            }
        }
    ]
}
